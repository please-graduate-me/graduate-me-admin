# 운영 빌드와 같은 Node.js 22 환경에서 로컬 개발을 실행한다.
FROM node:22-bookworm-slim
# 저장소에서 정한 pnpm 버전을 사용한다.
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
# 이후 명령과 소스 동기화의 기준 디렉터리를 정한다.
WORKDIR /app
# 코드 변경 시 의존성 설치 결과를 재사용하도록 목록부터 복사한다.
COPY package.json pnpm-lock.yaml ./
# 잠금 파일에 기록된 버전 그대로 의존성을 설치한다.
RUN pnpm install --frozen-lockfile
# 최초 실행할 소스를 복사하며 이후 변경은 개발 Compose가 동기화한다.
COPY . .
# 개발 웹 서버가 사용하는 내부 포트를 표시한다.
EXPOSE 3001
# 파일 변경을 반영하는 Vite 개발 서버를 실행한다.
CMD ["pnpm", "dev:app"]
